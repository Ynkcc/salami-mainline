arm64: dts: qcom: salami: Add power key and disable LOCALVERSION_AUTO

From: ynk <evils.ynk@gmail.com>

Signed-off-by: ynk <evils.ynk@gmail.com>
---
 arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts |    4 ++++
 arch/arm64/configs/salami_defconfig                |    1 +
 2 files changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
index 7849b8391997..816a616c2e7e 100644
--- a/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
+++ b/arch/arm64/boot/dts/qcom/sm8550-oneplus-salami.dts
@@ -572,6 +572,10 @@ &pm8550vs_g {
     status = "okay";
 };
 
+&pon_pwrkey {
+    status = "okay";
+};
+
 &pon_resin {
     linux,code = <KEY_VOLUMEUP>;
     status = "okay";
diff --git a/arch/arm64/configs/salami_defconfig b/arch/arm64/configs/salami_defconfig
index e53f1b37498f..11e56fd8903c 100644
--- a/arch/arm64/configs/salami_defconfig
+++ b/arch/arm64/configs/salami_defconfig
@@ -1,5 +1,6 @@
 # ==== Base ====
 CONFIG_LOCALVERSION="-salami"
+CONFIG_LOCALVERSION_AUTO=n
 
 # SOC
 CONFIG_SCSI_UFS_QCOM=y
