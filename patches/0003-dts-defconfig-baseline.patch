+/ {
+chassis-type = "handset";
+compatible = "oneplus,salami", "qcom,sm8550";
+model = "OnePlus 11 5G (salami)";
+qcom,board-id = <0x10008 0>;
+qcom,msm-id = <519 0x10000>, <536 0x10000>, <519 0x20000>, <536 0x20000>;
+
+aliases {
+    serial0 = &uart7;
+};
+
+chosen {
+    stdout-path = "serial0:115200n8";
+};
+
+gpio-keys {
+    compatible = "gpio-keys";
+    pinctrl-0 = <&key_vol_down_default>;
+    pinctrl-names = "default";
+
+    key-vol-down {
+        debounce-interval = <15>;
+        gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+        label = "Volume down";
+        linux,code = <KEY_VOLUMEDOWN>;
+        wakeup-source;
+    };
+};
+
+oplus_mem: memory {
+    ddr_device_type = <0x08>;
+    device_type = "memory";
+    reg = <0x00 0x80000000 0x00 0xe00000 0x00 0x811d0000 0x00 0x56e30000 0x00 0xd8140000 0x00 0x20000 0x00 0xd8800000 0x00 0x00 0x00 0xe1bb0000 0x00 0x1e450000 0x08 0x80000000 0x00 0x35700000 0x08 0xc0000000 0x01 0x40000000 0x0a 0x00 0x02 0x00>;
+};
+
+pmic-glink {
+    #address-cells = <1>;
+    #size-cells = <0>;
+    compatible = "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
+    orientation-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+
+    connector@0 {
+        compatible = "usb-c-connector";
+        data-role = "dual";
+        power-role = "dual";
+        reg = <0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                pmic_glink_hs_in: endpoint {
+                    remote-endpoint = <&usb_1_dwc3_hs>;
+                };
+            };
+
+            port@1 {
+                reg = <1>;
+
+                pmic_glink_ss_in: endpoint {
+                    remote-endpoint = <&usb_dp_qmpphy_out>;
+                };
+            };
+        };
+    };
+};
+
+reserved-memory {
+    chipinfo-region@81cf4000 {
+        no-map;
+        reg = <0x00 0x81cf4000 0x00 0x1000>;
+    };
+
+    llcc-lpi-region@ff800000 {
+        no-map;
+        reg = <0x00 0xff800000 0x00 0x600000>;
+    };
+
+    oem-vm-post-region@fcd04000 {
