salami: add eSIM GPIO support

From: ynk <evils.ynk@gmail.com>

Add a minimal driver that asserts the PM8550VS_G gpio4 eSIM select line at probe time.

Signed-off-by: ynk <evils.ynk@gmail.com>
---
 drivers/misc/Kconfig           |    8 ++++++
 drivers/misc/Makefile          |    1 +
 drivers/misc/oplus_esim_gpio.c |   56 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 65 insertions(+)
 create mode 100644 drivers/misc/oplus_esim_gpio.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 7364931dad3a..c4dac9cc98f2 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -586,4 +586,12 @@ source "drivers/misc/keba/Kconfig"
 source "drivers/misc/amd-sbi/Kconfig"
 source "drivers/misc/rp1/Kconfig"
 source "drivers/misc/issei/Kconfig"
+
+config OPLUS_ESIM_GPIO
+	tristate "OnePlus eSIM GPIO control"
+	depends on OF && GPIOLIB
+	help
+	  Assert the eSIM select GPIO on OnePlus salami so the modem sees
+	  the eSIM attached to its UIM2 slot.
+
 endmenu
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index e8d8d5d88c0d..5b97e16a328b 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -71,3 +71,4 @@ obj-y				+= keba/
 obj-y				+= amd-sbi/
 obj-$(CONFIG_MISC_RP1)		+= rp1/
 obj-$(CONFIG_INTEL_SSEI)	+= issei/
+obj-$(CONFIG_OPLUS_ESIM_GPIO)	+= oplus_esim_gpio.o
diff --git a/drivers/misc/oplus_esim_gpio.c b/drivers/misc/oplus_esim_gpio.c
new file mode 100644
index 000000000000..43cc5f4d2e4a
--- /dev/null
+++ b/drivers/misc/oplus_esim_gpio.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal eSIM GPIO control for OnePlus salami.
+ *
+ * On salami the eSIM is wired to the modem's UIM2 slot, selected by
+ * PM8550VS_G gpio4.  The vendor oplus-gpio driver toggles this line and
+ * asks the modem to power UIM2 up.  This driver asserts the eSIM select
+ * line at probe time so the modem sees the eSIM on UIM2.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/of.h>
+
+struct oplus_esim_gpio {
+	struct gpio_desc *esim;
+};
+
+static int oplus_esim_gpio_probe(struct platform_device *pdev)
+{
+	struct oplus_esim_gpio *priv;
+	struct device *dev = &pdev->dev;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->esim = devm_gpiod_get(dev, "esim-sel", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->esim))
+		return dev_err_probe(dev, PTR_ERR(priv->esim),
+				     "failed to get eSIM select GPIO\n");
+
+	dev_info(dev, "eSIM select GPIO asserted\n");
+
+	platform_set_drvdata(pdev, priv);
+	return 0;
+}
+
+static const struct of_device_id oplus_esim_gpio_of_match[] = {
+	{ .compatible = "oplus,oplus-gpio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, oplus_esim_gpio_of_match);
+
+static struct platform_driver oplus_esim_gpio_driver = {
+	.probe = oplus_esim_gpio_probe,
+	.driver = {
+		.name = "oplus-esim-gpio",
+		.of_match_table = oplus_esim_gpio_of_match,
+	},
+};
+module_platform_driver(oplus_esim_gpio_driver);
+
+MODULE_DESCRIPTION("OnePlus salami eSIM GPIO control");
+MODULE_LICENSE("GPL");
