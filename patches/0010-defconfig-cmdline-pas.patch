arm64: configs: salami: Set kernel command line and enable PAS

From: ynk <evils.ynk@gmail.com>

调整启动参数，无 initramfs 直接挂 rootfs 启动

将 QCOM_Q6V5_PAS 改为模块加载

Signed-off-by: ynk <evils.ynk@gmail.com>
---
 arch/arm64/configs/salami_defconfig |    4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/salami_defconfig b/arch/arm64/configs/salami_defconfig
index 7bf0f2d16..a45f1941e 100644
--- a/arch/arm64/configs/salami_defconfig
+++ b/arch/arm64/configs/salami_defconfig
@@ -530,7 +530,7 @@ CONFIG_PHY_QCOM_QMP=y
 CONFIG_CLK_IMX95_BLK_CTL=y
 CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
 CONFIG_ARM64_APPENDED_DTB=y
-CONFIG_CMDLINE="earlycon=efifb console=tty0 initcall_debug loglevel=7 keep_bootcon"
+CONFIG_CMDLINE="earlycon=efifb console=tty0 initcall_debug loglevel=7 keep_bootcon root=/dev/sda14 rootfstype=btrfs rootflags=subvol=@ rw rootwait"
 CONFIG_CMDLINE_FORCE=y
 CONFIG_ARCH_QCOM=y
 CONFIG_PCIE_QCOM=y
@@ -571,7 +571,7 @@ CONFIG_QCOM_RPROC_COMMON=y
 CONFIG_QCOM_PIL_INFO=y
 CONFIG_QCOM_Q6V5_COMMON=y
 CONFIG_QCOM_Q6V5_MSS=y
-CONFIG_QCOM_Q6V5_PAS=y
+CONFIG_QCOM_Q6V5_PAS=m
 CONFIG_QCOM_SYSMON=y
 CONFIG_QCOM_PD_MAPPER=y
 CONFIG_RPMSG_QCOM_GLINK_RPM=y
