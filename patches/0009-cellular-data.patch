salami: enable cellular data path

From: ynk <evils.ynk@gmail.com>

Fix the IPA QMI handshake with vendor modem firmware (SMEM item 497, INIT_DRIVER TLVs, INIT_COMPLETE) and map the modem SMEM filter table into the IPA IOMMU domain.

Signed-off-by: ynk <evils.ynk@gmail.com>
---
 drivers/net/ipa/ipa_mem.c     |   11 +++++
 drivers/net/ipa/ipa_qmi.c     |   50 ++++++++++++++++++++-
 drivers/net/ipa/ipa_qmi_msg.c |  100 +++++++++++++++++++++++++++++++++++++++++
 drivers/net/ipa/ipa_qmi_msg.h |   22 +++++++++
 4 files changed, 180 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ipa/ipa_mem.c b/drivers/net/ipa/ipa_mem.c
index 078d32a18dbf..284fd41e9866 100644
--- a/drivers/net/ipa/ipa_mem.c
+++ b/drivers/net/ipa/ipa_mem.c
@@ -539,6 +539,14 @@ static int ipa_smem_init(struct ipa *ipa, size_t size)
 	if (!size)
 		return 0;	/* SMEM memory not used */
 
+	/* This firmware allocates SMEM item 497 itself.  A host-side
+	 * pre-allocation makes the modem assert in ipa_ipfltr_sys_mem_init().
+	 * The mapping isn't used by the host except for QMI information.
+	 */
+	ipa->smem_iova = 0;
+	ipa->smem_size = size;
+	return 0;
+
 	/* SMEM is memory shared between the AP and another system entity
 	 * (in this case, the modem).  An allocation from SMEM is persistent
 	 * until the AP reboots; there is no way to free an allocated SMEM
@@ -597,6 +605,9 @@ static void ipa_smem_exit(struct ipa *ipa)
 	struct device *dev = ipa->dev;
 	struct iommu_domain *domain;
 
+	if (!ipa->smem_iova)
+		return;
+
 	domain = iommu_get_domain_for_dev(dev);
 	if (domain) {
 		size_t size;
diff --git a/drivers/net/ipa/ipa_qmi.c b/drivers/net/ipa/ipa_qmi.c
index d771f3a71f94..9001e773489c 100644
--- a/drivers/net/ipa/ipa_qmi.c
+++ b/drivers/net/ipa/ipa_qmi.c
@@ -7,6 +7,8 @@
 #include <linux/qrtr.h>
 #include <linux/string.h>
 #include <linux/types.h>
+#include <linux/iommu.h>
+#include <linux/soc/qcom/smem.h>
 
 #include "ipa.h"
 #include "ipa_mem.h"
@@ -72,6 +74,9 @@
 
 #define IPA_MODEM_SERVICE_SVC_ID	0x31
 #define IPA_MODEM_SERVICE_INS_ID	2
+
+#define IPA_QMI_SMEM_HOST_MODEM	1
+#define IPA_QMI_SMEM_FILTER_TABLE	497
 #define IPA_MODEM_SVC_VERS		1
 
 #define QMI_INIT_DRIVER_TIMEOUT		60000	/* A minute in milliseconds */
@@ -128,8 +133,8 @@ static void ipa_qmi_ready(struct ipa_qmi *ipa_qmi)
 	if (!ipa_qmi->modem_ready || !ipa_qmi->uc_ready)
 		return;
 
-	/* Send the indication message if it was requested */
-	ipa_qmi_indication(ipa_qmi);
+	/* This firmware expects INIT_COMPLETE even if it didn't request it */
+	ipa_server_init_complete(ipa_qmi);
 
 	/* The initial boot requires us to send the indication. */
 	if (ipa_qmi->initial_boot) {
@@ -372,6 +377,47 @@ init_modem_driver_req(struct ipa_qmi *ipa_qmi)
 		req.v6_hash_filter_tbl_start = ipa->mem_offset + mem->offset;
 	}
 
+	/* The modem allocates SMEM item 497; look it up and map it into the
+	 * IPA IOMMU domain so per_stats_smem_info carries a valid address.
+	 */
+	{
+		void *virt;
+		size_t actual;
+		struct iommu_domain *domain;
+
+		virt = qcom_smem_get(IPA_QMI_SMEM_HOST_MODEM,
+				     IPA_QMI_SMEM_FILTER_TABLE, &actual);
+		if (!IS_ERR(virt)) {
+			phys_addr_t phys = qcom_smem_virt_to_phys(virt);
+			domain = iommu_get_domain_for_dev(ipa->dev);
+			if (domain && !ipa->smem_iova)
+				if (!iommu_map(domain, phys, phys,
+					       PAGE_ALIGN(actual),
+					       IOMMU_READ | IOMMU_WRITE, GFP_KERNEL))
+					ipa->smem_iova = phys;
+			dev_info(ipa->dev, "smem item: phys=%pa size=%zu iova=%lx\n",
+				 &phys, actual, ipa->smem_iova);
+		} else {
+			dev_info(ipa->dev, "smem item not found: %ld\n", PTR_ERR(virt));
+		}
+	}
+
+	/* Tell the modem the SMEM region already reserved for filter tables */
+	req.smem_info_valid = 1;
+	req.smem_info.size = ipa->smem_size;
+	req.smem_info.start = (u32)ipa->smem_iova;
+
+	/* Vendor firmware also expects filter statistics and per-stat SMEM */
+	req.hw_filter_stats_info_valid = 1;
+	req.hw_filter_stats_info.start_addr = ipa->mem_offset + 0x27c0;
+	req.hw_filter_stats_info.size = 52 * 16;
+	req.hw_filter_stats_info.start_index = 128;
+	req.hw_filter_stats_info.end_index = 128 + 52 - 1;
+
+	req.per_stats_smem_info_valid = 1;
+	req.per_stats_smem_info.start = (u32)ipa->smem_iova;
+	req.per_stats_smem_info.size = 2 * 1024;
+
 	/* The stats fields are only valid for IPA v4.0+ */
 	if (ipa->version >= IPA_VERSION_4_0) {
 		mem = ipa_mem_find(ipa, IPA_MEM_STATS_QUOTA_MODEM);
diff --git a/drivers/net/ipa/ipa_qmi_msg.c b/drivers/net/ipa/ipa_qmi_msg.c
index 51dc13a577a5..d9c1684d37fb 100644
--- a/drivers/net/ipa/ipa_qmi_msg.c
+++ b/drivers/net/ipa/ipa_qmi_msg.c
@@ -250,6 +250,43 @@ const struct qmi_elem_info ipa_mem_range_ei[] = {
 	},
 };
 
+/* QMI message structure definition for struct ipa_filter_stats_info */
+const struct qmi_elem_info ipa_filter_stats_info_ei[] = {
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_filter_stats_info, start_addr),
+		.offset		= offsetof(struct ipa_filter_stats_info,
+					   start_addr),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof_field(struct ipa_filter_stats_info, size),
+		.offset		= offsetof(struct ipa_filter_stats_info, size),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_1_BYTE,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_filter_stats_info, start_index),
+		.offset		= offsetof(struct ipa_filter_stats_info,
+					   start_index),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_1_BYTE,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_filter_stats_info, end_index),
+		.offset		= offsetof(struct ipa_filter_stats_info,
+					   end_index),
+	},
+	{
+		.data_type	= QMI_EOTI,
+	},
+};
+
 /* QMI message structure definition for struct ipa_init_modem_driver_req */
 const struct qmi_elem_info ipa_init_modem_driver_req_ei[] = {
 	{
@@ -640,6 +677,69 @@ const struct qmi_elem_info ipa_init_modem_driver_req_ei[] = {
 		.offset		= offsetof(struct ipa_init_modem_driver_req,
 					   hw_stats_drop_size),
 	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_init_modem_driver_req,
+				     smem_info_valid),
+		.tlv_type	= 0x24,
+		.offset		= offsetof(struct ipa_init_modem_driver_req,
+					   smem_info_valid),
+	},
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_init_modem_driver_req,
+				     smem_info),
+		.tlv_type	= 0x24,
+		.offset		= offsetof(struct ipa_init_modem_driver_req,
+					   smem_info),
+		.ei_array	= ipa_mem_range_ei,
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_init_modem_driver_req,
+				     hw_filter_stats_info_valid),
+		.tlv_type	= 0x23,
+		.offset		= offsetof(struct ipa_init_modem_driver_req,
+					   hw_filter_stats_info_valid),
+	},
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_init_modem_driver_req,
+				     hw_filter_stats_info),
+		.tlv_type	= 0x23,
+		.offset		= offsetof(struct ipa_init_modem_driver_req,
+					   hw_filter_stats_info),
+		.ei_array	= ipa_filter_stats_info_ei,
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_init_modem_driver_req,
+				     per_stats_smem_info_valid),
+		.tlv_type	= 0x25,
+		.offset		= offsetof(struct ipa_init_modem_driver_req,
+					   per_stats_smem_info_valid),
+	},
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	=
+			sizeof_field(struct ipa_init_modem_driver_req,
+				     per_stats_smem_info),
+		.tlv_type	= 0x25,
+		.offset		= offsetof(struct ipa_init_modem_driver_req,
+					   per_stats_smem_info),
+		.ei_array	= ipa_mem_range_ei,
+	},
 	{
 		.data_type	= QMI_EOTI,
 	},
diff --git a/drivers/net/ipa/ipa_qmi_msg.h b/drivers/net/ipa/ipa_qmi_msg.h
index 644b8c27108b..98b10cb79f10 100644
--- a/drivers/net/ipa/ipa_qmi_msg.h
+++ b/drivers/net/ipa/ipa_qmi_msg.h
@@ -27,7 +27,7 @@
  */
 #define IPA_QMI_INDICATION_REGISTER_REQ_SZ	20	/* -> server handle */
 #define IPA_QMI_INDICATION_REGISTER_RSP_SZ	7	/* <- server handle */
-#define IPA_QMI_INIT_DRIVER_REQ_SZ		162	/* client handle -> */
+#define IPA_QMI_INIT_DRIVER_REQ_SZ		256	/* client handle -> */
 #define IPA_QMI_INIT_DRIVER_RSP_SZ		25	/* client handle <- */
 #define IPA_QMI_INIT_COMPLETE_IND_SZ		7	/* <- server handle */
 #define IPA_QMI_DRIVER_INIT_COMPLETE_REQ_SZ	4	/* -> server handle */
@@ -119,6 +119,14 @@ struct ipa_mem_range {
 	u32 size;
 };
 
+/* Filter/route statistics reported to the modem (IPA v4.0 and above) */
+struct ipa_filter_stats_info {
+	u32 start_addr;
+	u32 size;
+	u8 start_index;
+	u8 end_index;
+};
+
 /* The message for the IPA_QMI_INIT_DRIVER request contains information
  * from the AP that affects modem initialization.
  */
@@ -216,6 +224,18 @@ struct ipa_init_modem_driver_req {
 	u32			hw_stats_drop_base_addr;
 	u8			hw_stats_drop_size_valid;
 	u32			hw_stats_drop_size;
+
+	/* SMEM region used by the modem for IPA filter tables */
+	u8			smem_info_valid;
+	struct ipa_mem_range	smem_info;
+
+	/* Hardware filter statistics information (vendor TLV 0x23) */
+	u8				hw_filter_stats_info_valid;
+	struct ipa_filter_stats_info	hw_filter_stats_info;
+
+	/* SMEM region used by the modem for per-statistics (vendor TLV 0x25) */
+	u8			per_stats_smem_info_valid;
+	struct ipa_mem_range	per_stats_smem_info;
 };
 
 /* The response to a IPA_QMI_INIT_DRIVER request begins with a standard
