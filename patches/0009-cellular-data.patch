+/* The server handles three request message types sent by the modem. */
 static const struct qmi_msg_handler ipa_server_msg_handlers[] = {
 	{
 		.type		= QMI_REQUEST,
@@ -238,6 +271,13 @@ static const struct qmi_msg_handler ipa_server_msg_handlers[] = {
 		.decoded_size	= IPA_QMI_INDICATION_REGISTER_REQ_SZ,
 		.fn		= ipa_server_indication_register,
 	},
+	{
+		.type		= QMI_REQUEST,
+		.msg_id		= IPA_QMI_FILTER_INSTALLED_NOTIF,
+		.ei		= ipa_fltr_installed_notif_req_ei,
+		.decoded_size	= sizeof(struct ipa_fltr_installed_notif_req),
+		.fn		= ipa_server_filter_installed_notif,
+	},
 	{
 		.type		= QMI_REQUEST,
 		.msg_id		= IPA_QMI_DRIVER_INIT_COMPLETE,
@@ -372,6 +412,31 @@ init_modem_driver_req(struct ipa_qmi *ipa_qmi)
 		req.v6_hash_filter_tbl_start = ipa->mem_offset + mem->offset;
 	}
 
+	/* The modem's filter table system uses a SMEM item (497) which the
+	 * AP allocates at probe time (see ipa_smem_init()).  It is mapped
+	 * into the IPA IOMMU domain so the IPA can access it.  The modem
+	 * is told the item's exact address and size.
+	 */
+	req.smem_info_valid = 1;
+	req.smem_info.size = ipa->smem_size;
+	req.smem_info.start = 0;
+
+	/* Filter (route) statistics live in the IPA SRAM filter/route stats
+	 * region; 52 counters starting at index 128 are assigned to the
+	 * modem.
+	 */
+	mem = ipa_mem_find(ipa, IPA_MEM_STATS_FILTER_ROUTE);
+	req.hw_filter_stats_info_valid = 1;
+	req.hw_filter_stats_info.start_addr = ipa->mem_offset + mem->offset;
+	req.hw_filter_stats_info.size = 52 * 16;
+	req.hw_filter_stats_info.start_index = 128;
+	req.hw_filter_stats_info.end_index = 128 + 52 - 1;
+
+	/* The first 2 KiB of the SMEM item holds peripheral statistics */
+	req.per_stats_smem_info_valid = 1;
+	req.per_stats_smem_info.start = (u32)ipa->smem_phys;
+	req.per_stats_smem_info.size = 2 * 1024;
+
 	/* The stats fields are only valid for IPA v4.0+ */
 	if (ipa->version >= IPA_VERSION_4_0) {
 		mem = ipa_mem_find(ipa, IPA_MEM_STATS_QUOTA_MODEM);
