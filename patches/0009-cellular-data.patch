 	size_t actual;
+	size_t mapped;
 	void *virt;
 	int ret;
 
@@ -562,6 +563,7 @@ static int ipa_smem_init(struct ipa *ipa, size_t size)
 		return ret;
 	}
 
+
 	/* In case the region was already allocated, verify the size */
 	if (ret && actual != size) {
 		dev_err(dev, "SMEM item has size %zu, expected %zu\n",
@@ -569,6 +571,7 @@ static int ipa_smem_init(struct ipa *ipa, size_t size)
 		return -EINVAL;
 	}
 
+
 	domain = iommu_get_domain_for_dev(dev);
 	if (!domain) {
 		dev_err(dev, "no IOMMU domain found for SMEM\n");
@@ -578,16 +581,21 @@ static int ipa_smem_init(struct ipa *ipa, size_t size)
 	/* Align the address down and the size up to a page boundary */
 	addr = qcom_smem_virt_to_phys(virt);
 	phys = addr & PAGE_MASK;
-	size = PAGE_ALIGN(size + addr - phys);
+	mapped = PAGE_ALIGN(size + addr - phys);
 	iova = phys;	/* We just want a direct mapping */
 
-	ret = iommu_map(domain, iova, phys, size, IOMMU_READ | IOMMU_WRITE,
+	ret = iommu_map(domain, iova, phys, mapped, IOMMU_READ | IOMMU_WRITE,
 			GFP_KERNEL);
 	if (ret)
 		return ret;
 
+	/* The modem needs the exact (unaligned) address of the item; it
+	 * places the per-statistics block in its first 2 KiB.  The region
+	 * size reported through QMI must be the item size as well.
