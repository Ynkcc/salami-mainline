+	ipa->smem_phys = addr;
 
 	return 0;
 }
@@ -597,21 +605,28 @@ static void ipa_smem_exit(struct ipa *ipa)
 	struct device *dev = ipa->dev;
 	struct iommu_domain *domain;
 
+	if (!ipa->smem_iova)
+		return;
+
 	domain = iommu_get_domain_for_dev(dev);
 	if (domain) {
+		size_t mapped;
 		size_t size;
 
-		size = iommu_unmap(domain, ipa->smem_iova, ipa->smem_size);
-		if (size != ipa->smem_size)
+		/* The mapping covers the item and its offset within the page */
+		mapped = PAGE_ALIGN(ipa->smem_size +
+				    (ipa->smem_phys & ~PAGE_MASK));
+		size = iommu_unmap(domain, ipa->smem_iova, mapped);
+		if (size != mapped)
 			dev_warn(dev, "unmapped %zu SMEM bytes, expected %zu\n",
-				 size, ipa->smem_size);
-
+				 size, mapped);
 	} else {
 		dev_err(dev, "couldn't get IPA IOMMU domain for SMEM\n");
 	}
 
 	ipa->smem_size = 0;
 	ipa->smem_iova = 0;
+	ipa->smem_phys = 0;
 }
 
