+        data-role = "dual";
+        power-role = "dual";
+        reg = <0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                pmic_glink_hs_in: endpoint {
+                    remote-endpoint = <&usb_1_dwc3_hs>;
