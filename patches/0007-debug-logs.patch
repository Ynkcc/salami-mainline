index c7f8413ab996..4edc13cfd553 100644
--- a/drivers/firmware/qcom/Kconfig
+++ b/drivers/firmware/qcom/Kconfig
@@ -78,6 +78,16 @@ config QCOM_QSEECOM
 
 	  Select Y here to enable the QSEECOM interface driver.
 
+config QCOM_TZ_LOG
+	tristate "Qualcomm TZ/HYP log reader"
+	depends on PROC_FS
+	help
+	  Expose the hypervisor (HYP/EL2) diagnostic ring buffer through
+	  /proc/tzdbg/hyp_log and /proc/tzdbg/hyp_general. The physical address
+	  and size of the buffer are read from the IMEM cookie area described
+	  by a "qcom,tz-log" device tree node. Only the HYP path of the vendor
+	  tz_log driver is ported; QSEE/encrypted logs are not supported.
+
 config QCOM_QSEECOM_UEFISECAPP
 	bool "Qualcomm SEE UEFI Secure App client driver"
 	depends on QCOM_QSEECOM
