diff --git a/drivers/firmware/qcom/tz_log.c b/drivers/firmware/qcom/tz_log.c
new file mode 100644
index 000000000000..029111eff400
--- /dev/null
+++ b/drivers/firmware/qcom/tz_log.c
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal Qualcomm TZ/HYP diagnostic log reader.
+ *
+ * The hypervisor (EL2) keeps its diagnostic ring buffer in DDR.  The IMEM
+ * cookie area described by the "qcom,tz-log" device tree node contains the
+ * physical address and size of that buffer at the offsets given by the
+ * "hyplog-address-offset" / "hyplog-size-offset" properties.
+ *
+ * This driver exposes the ring buffer as /proc/tzdbg/hyp_log and a short
+ * status summary as /proc/tzdbg/hyp_general.  It is a stripped-down port of
+ * the vendor tz_log driver: only the HYP path is kept, so no ion, shmbridge,
+ * QSEECOM or encrypted-log support is needed.
+ */
+
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/types.h>
+
+#define TZDBG_MAX_CPUS		8
+#define HYP_LOG_MAX_SIZE	(4 * 1024 * 1024)
+
+struct hypdbg_log_pos {
+	u16	wrap;
+	u16	offset;
+};
+
+struct hypdbg_boot_info {
+	u32	warm_entry_cnt;
+	u32	warm_exit_cnt;
+};
+
+/* Layout copied from the vendor tz_log driver. */
+struct hypdbg_header {
+	u32	magic_num;
+	u32	cpu_count;
+	u32	ring_off;
+	struct hypdbg_log_pos log_pos;
+	u32	log_len;
+	u32	s2_fault_counter;
+	struct hypdbg_boot_info boot_info[TZDBG_MAX_CPUS];
+	u8	log_buf[];
+};
+
+struct qcom_tzlog {
+	struct device		*dev;
+	void __iomem		*imem;
+	void __iomem		*hyp;
+	size_t			 hyp_size;
+	size_t			 ring_off;
+	size_t			 ring_len;
+	u8			*snapshot;
+	u8			*display;
+	struct proc_dir_entry	*dir;
+	struct mutex		 lock;
+};
+
+static struct qcom_tzlog *tzlog;
+
+static struct hypdbg_header *tzlog_read_header(struct qcom_tzlog *tz)
+{
+	memcpy_fromio(tz->snapshot, tz->hyp, tz->hyp_size);
+	return (struct hypdbg_header *)tz->snapshot;
+}
+
+static int hyp_log_show(struct seq_file *m, void *v)
+{
+	struct qcom_tzlog *tz = m->private;
+	struct hypdbg_header *hdr;
+	size_t off;
+
+	if (!tz || !tz->hyp)
+		return -ENODEV;
+
+	mutex_lock(&tz->lock);
+	hdr = tzlog_read_header(tz);
+
+	/* log_pos.offset is the write pointer; the oldest byte follows it. */
+	off = hdr->log_pos.offset;
+	if (off >= tz->ring_len)
+		off = 0;
+
+	memcpy(tz->display, tz->snapshot + tz->ring_off + off,
+	       tz->ring_len - off);
+	memcpy(tz->display + tz->ring_len - off,
+	       tz->snapshot + tz->ring_off, off);
+	seq_write(m, tz->display, tz->ring_len);
+
+	mutex_unlock(&tz->lock);
+	return 0;
+}
+
+static int hyp_general_show(struct seq_file *m, void *v)
+{
+	struct qcom_tzlog *tz = m->private;
+	struct hypdbg_header *hdr;
+	int i;
+
+	if (!tz || !tz->hyp)
+		return -ENODEV;
+
+	mutex_lock(&tz->lock);
+	hdr = tzlog_read_header(tz);
+
+	seq_printf(m, "magic           : 0x%08x\n", hdr->magic_num);
+	seq_printf(m, "cpu_count       : %u\n", hdr->cpu_count);
+	seq_printf(m, "ring_off        : 0x%x\n", hdr->ring_off);
+	seq_printf(m, "log_len         : 0x%x\n", hdr->log_len);
+	seq_printf(m, "wrap / offset   : %u / %u\n",
+		   hdr->log_pos.wrap, hdr->log_pos.offset);
+	seq_printf(m, "s2_fault_count  : %u\n", hdr->s2_fault_counter);
+	for (i = 0; i < min_t(u32, hdr->cpu_count, TZDBG_MAX_CPUS); i++)
+		seq_printf(m, "cpu%d: warm enter %u, warm exit %u\n", i,
+			   hdr->boot_info[i].warm_entry_cnt,
+			   hdr->boot_info[i].warm_exit_cnt);
+
+	mutex_unlock(&tz->lock);
+	return 0;
+}
+
+static int tzlog_single_open(struct inode *inode, struct file *file,
+			     int (*show)(struct seq_file *, void *))
+{
+	return single_open(file, show, pde_data(inode));
+}
+
+static int hyp_log_open(struct inode *inode, struct file *file)
+{
+	return tzlog_single_open(inode, file, hyp_log_show);
+}
+
+static int hyp_general_open(struct inode *inode, struct file *file)
+{
+	return tzlog_single_open(inode, file, hyp_general_show);
+}
+
+static const struct proc_ops hyp_log_proc_ops = {
+	.proc_open	= hyp_log_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static const struct proc_ops hyp_general_proc_ops = {
+	.proc_open	= hyp_general_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static int tz_log_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct qcom_tzlog *tz;
+	struct resource *res;
+	struct hypdbg_header *hdr;
+	u32 addr_offset, size_offset;
+	phys_addr_t hyp_phys;
+	u32 hyp_size;
+	int ret;
+
+	if (tzlog)
+		return -EBUSY;
+
+	tz = devm_kzalloc(dev, sizeof(*tz), GFP_KERNEL);
+	if (!tz)
+		return -ENOMEM;
+
+	tz->dev = dev;
+	mutex_init(&tz->lock);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -ENXIO;
+
+	tz->imem = devm_ioremap(dev, res->start, resource_size(res));
+	if (!tz->imem)
+		return -ENXIO;
+
+	ret = of_property_read_u32(dev->of_node, "hyplog-address-offset",
+				   &addr_offset);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing hyplog address offset\n");
+
+	ret = of_property_read_u32(dev->of_node, "hyplog-size-offset",
+				   &size_offset);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing hyplog size offset\n");
+
+	hyp_phys = readl_relaxed(tz->imem + addr_offset);
+	hyp_size = readl_relaxed(tz->imem + size_offset);
+	if (!hyp_phys || hyp_size < sizeof(struct hypdbg_header) ||
+	    hyp_size > HYP_LOG_MAX_SIZE)
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid HYP log region %pa size %u\n",
+				     &hyp_phys, hyp_size);
+
+	tz->hyp_size = hyp_size;
+	tz->hyp = devm_ioremap(dev, hyp_phys, hyp_size);
+	if (!tz->hyp)
+		return -ENXIO;
+
+	tz->snapshot = devm_kzalloc(dev, hyp_size, GFP_KERNEL);
+	if (!tz->snapshot)
+		return -ENOMEM;
+
+	hdr = tzlog_read_header(tz);
+	if (hdr->ring_off >= hyp_size) {
+		dev_err(dev, "invalid HYP ring offset 0x%x (size %u)\n",
+			hdr->ring_off, hyp_size);
+		return -EINVAL;
+	}
+	tz->ring_off = hdr->ring_off;
+	tz->ring_len = hyp_size - hdr->ring_off;
+
+	tz->display = devm_kzalloc(dev, tz->ring_len, GFP_KERNEL);
+	if (!tz->display)
+		return -ENOMEM;
+
+	tz->dir = proc_mkdir("tzdbg", NULL);
+	if (!tz->dir)
+		return -ENOMEM;
+
+	if (!proc_create_data("hyp_log", 0444, tz->dir,
+			      &hyp_log_proc_ops, tz)) {
+		ret = -ENOMEM;
+		goto err_remove_dir;
+	}
+	if (!proc_create_data("hyp_general", 0444, tz->dir,
+			      &hyp_general_proc_ops, tz)) {
+		ret = -ENOMEM;
+		goto err_remove_hyp_log;
+	}
+
+	tzlog = tz;
+	dev_info(dev, "HYP log at %pa size %u, ring %zu\n",
+		 &hyp_phys, hyp_size, tz->ring_len);
+	return 0;
+
+err_remove_hyp_log:
+	remove_proc_entry("hyp_log", tz->dir);
+err_remove_dir:
+	remove_proc_entry("tzdbg", NULL);
+	return ret;
+}
+
+static void tz_log_remove(struct platform_device *pdev)
+{
+	if (!tzlog)
+		return;
+
+	remove_proc_entry("hyp_general", tzlog->dir);
+	remove_proc_entry("hyp_log", tzlog->dir);
+	remove_proc_entry("tzdbg", NULL);
+	tzlog = NULL;
+}
+
+static const struct of_device_id tzlog_match[] = {
+	{ .compatible = "qcom,tz-log" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tzlog_match);
+
+static struct platform_driver tz_log_driver = {
+	.probe		= tz_log_probe,
+	.remove		= tz_log_remove,
+	.driver		= {
+		.name		= "qcom-tz-log",
+		.of_match_table	= tzlog_match,
+	},
+};
+module_platform_driver(tz_log_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Qualcomm TZ/HYP diagnostic log reader");
