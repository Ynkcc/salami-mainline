+	.htotal = 1202,
+	.vdisplay = 2412,
+	.vsync_start = 2412 + 2,
+	.vsync_end = 2412 + 2 + 2,
+	.vtotal = 2424,
+	.width_mm = 68,
+	.height_mm = 154,
+};
