+struct amb670yf07_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset_gpio;
+	bool prepared;
+};
+
+static inline struct amb670yf07_panel *to_amb670yf07_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct amb670yf07_panel, panel);
+}
+
+static void amb670yf07_reset(struct amb670yf07_panel *ctx)
+{
+	/*
+	 * reset-gpios 为 GPIO_ACTIVE_LOW，最终必须停在逻辑 0（物理高=释放复位），
+	 * 否则面板停在复位态、不响应任何 DCS 命令（黑屏）。
+	 * 与下游 qcom,mdss-dsi-reset-sequence = <1 10>, <0 5>, <1 10>
+	 * （物理高 10ms -> 低 5ms -> 高 10ms）一致。
+	 */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static void amb670yf07_on(struct amb670yf07_panel *ctx,
