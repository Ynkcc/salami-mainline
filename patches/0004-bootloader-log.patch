diff --git a/drivers/soc/qcom/bootloader_log.c b/drivers/soc/qcom/bootloader_log.c
new file mode 100644
index 000000000000..1c4d86fdb2ab
--- /dev/null
+++ b/drivers/soc/qcom/bootloader_log.c
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bootloader log reader for Qualcomm devices with oplus ABL.
+ *
+ * Maps the ABL-reserved log buffer and exposes it as /proc/bootloader_log.
+ * Ported from oplus vendor tree (vendor/oplus/kernel/boot/misc/bootloader_log.c).
+ *
+ * Copyright (C) 2018-2020 Oplus. All rights reserved.
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 only as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/of_address.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+
+struct bootloader_log_ram_zone {
+	phys_addr_t paddr;
+	size_t size;
+	void *vaddr;
+};
+
+static struct bootloader_log_ram_zone blrz;
+static struct proc_dir_entry *bootloader_log_proc_entry;
+
+static int bootloader_log_proc_show(struct seq_file *m, void *v)
+{
+	if (!blrz.vaddr)
+		return -ENODEV;
+
+	seq_puts(m, blrz.vaddr);
+	seq_putc(m, '\n');
+	return 0;
+}
+
+static int bootloader_log_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, bootloader_log_proc_show, NULL);
+}
+
+static const struct proc_ops bootloader_log_proc_fops = {
+	.proc_open	= bootloader_log_proc_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static int bootloader_log_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct device_node *pnode;
+	struct resource res;
+	int ret;
+
+	pnode = of_parse_phandle(np, "linux,contiguous-region", 0);
+	if (!pnode) {
+		dev_err(dev, "mem reservation for bootloader log not present\n");
+		return -EINVAL;
+	}
+
+	ret = of_address_to_resource(pnode, 0, &res);
+	of_node_put(pnode);
+	if (ret) {
+		dev_err(dev, "failed to parse the bootloader log memory region\n");
+		return ret;
+	}
+
+	blrz.paddr = res.start;
+	blrz.size = resource_size(&res);
+
+	/*
+	 * The reserved-memory node is marked no-map, so map it here.
+	 * Use write-combine so the buffer stays cacheable-ish but is
+	 * safe to read without explicit cache maintenance.
+	 */
+	blrz.vaddr = memremap(blrz.paddr, blrz.size, MEMREMAP_WC);
+	if (!blrz.vaddr) {
+		dev_err(dev, "failed to map 0x%pa (%zu bytes)\n",
+			&blrz.paddr, blrz.size);
+		return -ENOMEM;
+	}
+
+	/* NUL-terminate in case the log fills the buffer completely. */
+	((char *)blrz.vaddr)[blrz.size - 1] = '\0';
+
+	bootloader_log_proc_entry =
+		proc_create("bootloader_log", 0444, NULL,
+			    &bootloader_log_proc_fops);
+	if (!bootloader_log_proc_entry) {
+		dev_err(dev, "failed to create /proc/bootloader_log\n");
+		memunmap(blrz.vaddr);
+		blrz.vaddr = NULL;
+		return -ENOMEM;
+	}
+
+	dev_info(dev, "mapped 0x%pa (%zu bytes) -> /proc/bootloader_log\n",
+		 &blrz.paddr, blrz.size);
+	return 0;
+}
+
+static void bootloader_log_remove(struct platform_device *pdev)
+{
+	proc_remove(bootloader_log_proc_entry);
+	bootloader_log_proc_entry = NULL;
+	memunmap(blrz.vaddr);
+	blrz.vaddr = NULL;
+}
+
+static const struct of_device_id bootloader_log_of_match[] = {
+	{ .compatible = "oplus,bootloader-log" },
+	{ .compatible = "bootloader_log" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bootloader_log_of_match);
+
+static struct platform_driver bootloader_log_driver = {
+	.probe	= bootloader_log_probe,
+	.remove	= bootloader_log_remove,
+	.driver	= {
+		.name	= "bootloader_log",
+		.of_match_table = bootloader_log_of_match,
+	},
+};
+
+module_platform_driver(bootloader_log_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Qualcomm oplus ABL bootloader log reader (/proc/bootloader_log)");
+MODULE_AUTHOR("software@oneplus.cn");
