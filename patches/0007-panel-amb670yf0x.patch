diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index b292dfd266d1..75c2191b551f 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1908,11 +1908,20 @@ static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc
 	drm_dsc_set_const_params(dsc);
 	drm_dsc_set_rc_buf_thresh(dsc);
 
-	/* DPU supports only pre-SCR panels */
-	ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
-	if (ret) {
-		DRM_DEV_ERROR(&msm_host->pdev->dev, "could not find DSC RC parameters\n");
-		return ret;
+	/*
+	 * DPU supports only pre-SCR panels.  Panels that pre-populated the RC
+	 * parameters (non-zero initial_offset, e.g. to mirror a hard-coded
+	 * panel-side DSC config like the 0x9e command written by the Samsung
+	 * AMB670YF0x init sequence) keep their values: setup_rc_params() would
+	 * otherwise clobber first_line_bpg_offset and the RC range tables and
+	 * desynchronize the encoder from the panel decoder.
+	 */
+	if (!dsc->initial_offset) {
+		ret = drm_dsc_setup_rc_params(dsc, DRM_DSC_1_1_PRE_SCR);
+		if (ret) {
+			DRM_DEV_ERROR(&msm_host->pdev->dev, "could not find DSC RC parameters\n");
+			return ret;
+		}
 	}
 
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
