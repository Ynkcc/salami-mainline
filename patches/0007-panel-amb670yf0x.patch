-MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/panel/panel-samsung-amb670yf0x.c b/drivers/gpu/drm/panel/panel-samsung-amb670yf0x.c
new file mode 100644
index 000000000000..6b3e41b228fe
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-amb670yf0x.c
@@ -0,0 +1,832 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung AMB670YF07 / AMB670YF08 (OnePlus 11 / "salami") 1080x2412@120
+ * DSC command-mode panels.
+ *
+ * The four variants used on this platform -- AMB670YF07 CS, AMB670YF07 FS,
+ * AMB670YF08 CS and AMB670YF08 FS -- share everything the DRM/KMS side cares
+ * about (DSC parameters, DSI lane count, pixel format, backlight handling and
+ * reset timing) and differ only in their power-on sequence.  One driver
+ * therefore carries all of them and picks the right sequence at runtime from
+ * the panel ID read over DCS.
+ *
+ * ===========================================================================
+ * The command sequences are not hand-written.  The regions delimited by the
+ * comment pairs
+ *
+ *	"lmdpdg:begin <panel-id> <kind> -> <name>"
+ *	"lmdpdg:end"
+ *
+ * are generated from the vendor (Oplus) device tree by
+ * linux-mdss-dsi-panel-driver-generator, so they always match the DT exactly.
+ * Refresh them after any DT change with
+ *
+ *	cd tools/lmdpdg
+ *	python3 splice.py \
+ *	    --dtb    ../../fdt-runtime-20260924/fdt-salami.dtb \
+ *	    --file   ../../salami/salami-mainline/drivers/gpu/drm/panel/panel-samsung-amb670yf0x.c \
+ *	    --struct amb670yf0x
+ *
+ * splice.py --check fails when a region has drifted from the device tree.
+ * Everything outside the markers (variant dispatch, panel ID detection,
+ * regulator / reset / backlight handling, probe) is hand-written.  All
+ * generated regions are kept together at the very end of this file, after the
+ * hand-written driver code.
+ * ===========================================================================
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include <video/mipi_display.h>
+
+struct amb670yf0x;
+
+/*
+ * Sentinel for panel IDs that are not confirmed yet.  Fill in the 24-bit
+ * DCS ID reported by the "panel-id" lines this driver prints on the first
+ * power-up and the runtime detection below becomes fully automatic.
+ */
+#define AMB670YF0X_ID_UNKNOWN	0x000000
+
+/*
+ * Panel identification uses the standard DCS ID registers 0xDA/0xDB/0xDC.
+ * The vendor's qcom,mdss-dsi-panel-id1-command register 0xE9 reads back
+ * 0x00 on these panels and is useless.  Measured on AMB670YF07:
+ * DA=0xA7 DB=0x07 DC=0x01 -- the DB byte carries the model digit.
+ */
+#define AMB670YF0X_ID_YF07	0xa70701
+#define AMB670YF0X_ID_YF08	AMB670YF0X_ID_UNKNOWN /* TODO: fill from a YF08 boot log */
+
+/*
+ * Panel node the shared generated sequences (reset / off / mode) are taken
+ * from.  Both YF07 variants describe them identically.
+ */
+#define AMB670YF0X_REF_PANEL	"panel_samsung_amb670yf07_cs_1440_3216_dsc_cmd"
+
+struct amb670yf0x_variant {
+	/* Human readable name, used in the boot log. */
+	const char *name;
+	/* 24-bit DCS 0xDA/0xDB/0xDC ID, or AMB670YF0X_ID_UNKNOWN. */
+	unsigned int id;
+	/* Panel specific power-on sequence, generated from the DT. */
+	int (*on)(struct amb670yf0x *ctx);
+};
+
+struct amb670yf0x {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset_gpio;
+	const struct amb670yf0x_variant *variant;
+	/*
+	 * Power-on sequence actually used.  Starts as the variant chosen by
+	 * the compatible and may be switched by the ID detection, which can
+	 * only tell the panel generation (YF07 vs YF08) apart -- the CS/FS
+	 * split is a firmware/region thing invisible to the ID registers and
+	 * therefore stays under device tree control.
+	 */
+	int (*on)(struct amb670yf0x *ctx);
+	bool detected;
+	bool prepared;
+};
+
+/* Generated sequences live at the end of this file. */
+static int amb670yf07_on(struct amb670yf0x *ctx);
+static int amb670yf08_on(struct amb670yf0x *ctx);
+static void amb670yf0x_reset(struct amb670yf0x *ctx);
+static int amb670yf0x_off(struct amb670yf0x *ctx);
+static const struct drm_display_mode amb670yf0x_mode;
+
+static inline struct amb670yf0x *to_amb670yf0x(struct drm_panel *panel)
+{
+	return container_of(panel, struct amb670yf0x, panel);
+}
+
+enum {
+	AMB670YF0X_07_CS,
+	AMB670YF0X_07_FS,
+	AMB670YF0X_08_CS,
+	AMB670YF0X_08_FS,
+};
+
+static const struct amb670yf0x_variant amb670yf0x_variants[] = {
+	[AMB670YF0X_07_CS] = {
+		.name = "AMB670YF07 CS",
+		.id = AMB670YF0X_ID_YF07,
+		.on = amb670yf07_on,
+	},
+	[AMB670YF0X_07_FS] = {
+		.name = "AMB670YF07 FS",
+		.id = AMB670YF0X_ID_YF07,
+		.on = amb670yf07_on,
+	},
+	[AMB670YF0X_08_CS] = {
+		.name = "AMB670YF08 CS",
+		.id = AMB670YF0X_ID_YF08,
+		.on = amb670yf08_on,
+	},
+	[AMB670YF0X_08_FS] = {
+		.name = "AMB670YF08 FS",
+		.id = AMB670YF0X_ID_YF08,
+		.on = amb670yf08_on,
+	},
+};
+
+/*
+ * Read the panel ID (DCS 0xDA/0xDB/0xDC) and, if it matches a known panel
+ * generation, switch to that generation's power-on sequence.  Never fails the
+ * caller: if the read does not work we simply keep the sequence the device
+ * tree asked for.
+ */
+static void amb670yf0x_detect(struct amb670yf0x *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	unsigned int id = 0;
+	unsigned int i;
+	int ret;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	for (i = 0; i < 3; i++) {
+		u8 v = 0;
+
+		ret = mipi_dsi_dcs_read(ctx->dsi, 0xda + i, &v, 1);
+		dev_info(dev, "panel-id DCS 0x%02x -> ret=%d val=0x%02x\n",
+			 0xda + i, ret, ret > 0 ? v : 0);
+		if (ret != 1)
+			goto done;
+		id = (id << 8) | v;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(amb670yf0x_variants); i++) {
+		if (!amb670yf0x_variants[i].id ||
+		    amb670yf0x_variants[i].id != id)
+			continue;
+		if (ctx->on != amb670yf0x_variants[i].on) {
+			dev_info(dev,
+				 "Panel ID 0x%06x: using %s power-on sequence (DT said %s)\n",
+				 id, amb670yf0x_variants[i].name,
+				 ctx->variant->name);
+			ctx->on = amb670yf0x_variants[i].on;
+		}
+		goto done;
+	}
+	dev_warn(dev, "Unknown panel ID 0x%06x, keeping %s sequence\n",
+		 id, ctx->variant->name);
+
+done:
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ctx->detected = true;
+}
+
+static int amb670yf0x_disable(struct drm_panel *panel)
+{
+	struct amb670yf0x *ctx = to_amb670yf0x(panel);
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	return amb670yf0x_off(ctx);
+}
+
+static int amb670yf0x_prepare(struct drm_panel *panel)
+{
+	struct amb670yf0x *ctx = to_amb670yf0x(panel);
+	struct drm_dsc_picture_parameter_set pps;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int ret;
+
+	ctx->prepared = true;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return ret;
+
+	amb670yf0x_reset(ctx);
+
+	/* 面板硬件识别（host 已使能，可读）：确认实际面板型号并选用对应序列 */
+	if (!ctx->detected)
+		amb670yf0x_detect(ctx);
+
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	mipi_dsi_compression_mode_ext_multi(&dsi_ctx, true, MIPI_DSI_COMPRESSION_DSC, 0);
+
+	if (dsi_ctx.accum_err) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		ctx->prepared = false;
+		return dsi_ctx.accum_err;
+	}
+
+	/* The DT sequences are sent in LP mode. */
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = ctx->on(ctx);
+
+	if (ret) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
