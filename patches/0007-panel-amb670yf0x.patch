+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 36;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 10;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+	ctx->dsc.convert_rgb = true;
+
+	/*
+	 * The panel-side DSC decoder is hard-configured by the 0x9e command in
+	 * the on-sequence above (vendor DT), so the encoder must match it
+	 * field by field -- any rate-control mismatch shows up as garbage.
+	 *
+	 * Decoding the 0x9e payload (QCOM DSC 1.1 pre-SCR PPS layout) yields
+	 * exactly the downstream DSC_V11_SCR1_10BPC_8BPP tables
+	 * (refs/.../display-drivers/msm/sde_dsc_helper.c) EXCEPT
+	 * first_line_bpg_offset, which the vendor data carries as 14 (the DSC
+	 * 1.2 slice-height-based value for slice_height=36), not 12.  The
+	 * stock upstream drm_dsc_setup_rc_params(DRM_DSC_1_1_PRE_SCR) table
+	 * differs from 0x9e in exactly the entries overridden below, so start
+	 * from it and patch the delta; drm_dsc_compute_rc_parameters() then
+	 * reproduces every derived 0x9e field (nfl_bpg_offset=820,
+	 * initial_dec_delay=571, slice_bpg_offset=724, final_offset=4336,
+	 * scale_increment_interval=821, scale_decrement_interval=7).
+	 */
+	ret = drm_dsc_setup_rc_params(&ctx->dsc, DRM_DSC_1_1_PRE_SCR);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to setup DSC RC params\n");
+
+	ctx->dsc.first_line_bpg_offset = 14;
+	ctx->dsc.rc_range_params[0].range_max_qp = 8;
+	ctx->dsc.rc_range_params[11].range_max_qp = 15;
+	ctx->dsc.rc_range_params[12].range_max_qp = 15;
+	ctx->dsc.rc_range_params[13].range_min_qp = 13;
+	ctx->dsc.rc_range_params[13].range_max_qp = 16;
+	ctx->dsc.rc_range_params[14].range_min_qp = 16;
+	ctx->dsc.rc_range_params[14].range_max_qp = 17;
+
+	drm_dsc_set_const_params(&ctx->dsc);
+	drm_dsc_set_rc_buf_thresh(&ctx->dsc);
+	ctx->dsc.initial_scale_value = drm_dsc_initial_scale_value(&ctx->dsc);
+	ctx->dsc.line_buf_depth = ctx->dsc.bits_per_component + 1;
+
+	ret = drm_dsc_compute_rc_parameters(&ctx->dsc);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "Failed to compute DSC RC parameters\n");
+
+	dsi->dsc = &ctx->dsc;
+	/* NOTE: RGB101010 (stock bpp=30) was tested and garbles badly here;
+	 * RGB888 keeps the picture stable. */
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	dev_info(dev, "Probed with %s variant\n", ctx->variant->name);
+
+	return 0;
+}
