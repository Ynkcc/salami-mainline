+static struct backlight_device *
+amb670yf0x_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		/*
+		 * DBV 实测为 11 位：0..2047，值越大越亮，0 = 灭。
+		 * 默认取最亮，保证 prepare 之后无需任何用户态干预即可看到画面
+		 * （rootfs 场景）；用户态可往小调暗。
+		 */
+		.brightness = 2047,
+		.max_brightness = 2047,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &amb670yf0x_bl_ops, &props);
+}
